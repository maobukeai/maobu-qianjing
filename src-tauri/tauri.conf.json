{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "猫步·千境",
  "version": "3.0.0",
  "identifier": "com.maobu.local",
  "build": {
    "frontendDist": "bootstrap"
  },
  "app": {
    "windows": [],
    "security": {
      "capabilities": [],
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' http://127.0.0.1:* ws://127.0.0.1:* ipc: http://ipc.localhost https://ipc.localhost; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "publisher": "猫步·千境",
    "copyright": "Copyright © 2026 Xreacher; local-only modifications by 猫步·千境 contributors",
    "createUpdaterArtifacts": false,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "externalBin": ["binaries/aliasmode-sidecar"],
    "resources": {
      "resources/firefox/": "firefox/",
      "resources/playwright/": "playwright/"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper",
        "silent": true
      },
      "nsis": {
        "compression": "lzma",
        "languages": ["English", "SimpChinese"],
        "template": "windows/installer.nsi",
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico"
      }
    }
  }
}
